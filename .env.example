# Docker & Server Configuration
HOST_PORT=9876
PYTHONUNBUFFERED=1

# App Settings
APP_ENV=development
APP_HOST=0.0.0.0

# Moodle Integration (Optional)
# Leave empty if not using Moodle integration yet
MOODLE_URL=https://tu-moodle.universidad.edu
MOODLE_TOKEN=your_moodle_token_here
MOODLE_COURSE_ID=1

# Persistence (SQLite by default; any SQLAlchemy URL works, e.g. PostgreSQL)
# DATABASE_URL=sqlite:////app/data/handsonedu.db

# Teacher/admin token for write endpoints (sign templates, LTI platforms). Empty = open (dev only).
ADMIN_TOKEN=

# Public origin of HandsOnEdu as Moodle and browsers reach it (LTI 1.3 URLs). HTTPS in production.
PUBLIC_BASE_URL=http://localhost:9876
