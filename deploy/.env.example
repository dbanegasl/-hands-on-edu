# Copy to .env next to docker-compose.yml and deploy.sh.

# Version of the image to run; deploy.sh updates this line.
HANDSONEDU_VERSION=latest
# HANDSONEDU_IMAGE=ghcr.io/dbanegasl/handsonedu

# Public HTTPS origin exactly as Moodle and browsers reach it (no trailing slash).
PUBLIC_BASE_URL=https://senas.miescuela.edu.ec
# Long random string: openssl rand -hex 32. Empty = open (never in production).
ADMIN_TOKEN=
# Local port the reverse proxy targets.
HOST_PORT=9876
WEB_CONCURRENCY=2
# DATABASE_URL=sqlite:////app/data/handsonedu.db
